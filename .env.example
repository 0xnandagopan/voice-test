# Local development only. Never commit .env.
DATABASE_URL=postgres://v0:v0_local_only@127.0.0.1:55432/v0
# Local override. On Railway, omit BIND_ADDR so PORT binds to 0.0.0.0.
BIND_ADDR=127.0.0.1:3000
# false for Railway API with the frontend on Vercel; true for local built UI.
SERVE_WEB=true
# Keep one APP_ORIGIN. For HTTPS controlled tests, replace this value with
# the tunnel origin and set COOKIE_SECURE=true. For the split deployment use:
# APP_ORIGIN=https://voice-test-app.trypreview.online
# VOICE_PUBLIC_ORIGIN=https://voice-test-api.trypreview.online
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
AGENCY_NAME='Your agency'
OPERATOR_USERNAME=operator
# Generate with: cargo run -p v0-app -- hash-password (password on stdin)
OPERATOR_PASSWORD_HASH=
# At least 32 random bytes, encoded as text. Keep stable across restarts.
INVITATION_SIGNING_KEY=
VOICE_AGENT_API_KEY=
GATEWAY_MODEL=
# Ordinary live Start remains disabled. Enable only for a controlled test instance.
VOICE_TEST_ENABLED=false
VOICE_PUBLIC_ORIGIN=https://your-controlled-tunnel.example
RUST_LOG=info
# Local development files. Both deployed services MUST instead use s3 and
# the same private bucket; container-local files are ephemeral and not shared.
EVIDENCE_STORAGE_BACKEND=local
EVIDENCE_STORAGE_DIR=.local/private-evidence
# For s3, take these values from the bucket Credentials tab, not its display name.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Leave false unless the storage provider requires path-style addressing.
S3_FORCE_PATH_STYLE=false
# Set exact trusted HTTPS artifact hostnames after inspecting provider history.
VOICE_ARTIFACT_HOSTS=speech-to-speech-production-euw1-sessions.s3.amazonaws.com
# Bounded worker decoding; use installed binaries or explicit local paths.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
EVIDENCE_WORK_DIR=.local/evidence-jobs
